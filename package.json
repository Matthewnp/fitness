{
  "name": "fitness",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "sever": "node server.js",
    "webhook": "stripe listen --events checkout.session.completed --forward-to localhost:4000/api/checkout/webhook",
    "dev:all": "concurrently -n API,WEBHOOK,WEB -c blue,magenta,green \"npm run server\" \"npm run webhook\" ",
    "redeploy": "npm run build",
    "deploy": "gh-pages -d dist", 
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@neondatabase/serverless": "^1.2.0",
    "@stripe/stripe-js": "^10.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "and": "^0.0.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.0",
    "stripe": "^23.1.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
